# Client-visible configuration only. Never put API keys/secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://YOUR_REGION.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=

# Used by Appwrite React Native to identify the native platform.
EXPO_PUBLIC_IOS_BUNDLE_ID=com.dzikle.universalstarter
EXPO_PUBLIC_ANDROID_PACKAGE=com.dzikle.universalstarter

# Must be registered as an allowed Appwrite redirect URL before password recovery is enabled.
EXPO_PUBLIC_PASSWORD_RECOVERY_URL=

# Enable only providers configured in the Appwrite Console.
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false
EXPO_PUBLIC_AUTH_GITHUB_ENABLED=false
EXPO_PUBLIC_AUTH_FACEBOOK_ENABLED=false

# Optional Appwrite Messaging push provider ID. If omitted, Appwrite uses the first configured push provider.
EXPO_PUBLIC_APPWRITE_PUSH_PROVIDER_ID=
